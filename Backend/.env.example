# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=
PORT=3000
# Optional: preserve the original MongoDB/Prisma account storage.
# Omit to store local accounts in SQLite alongside topics.
# DATABASE_URL=mongodb+srv://...
# SQLITE_PATH=/absolute/path/to/persistent/topics.db
# CORS_ORIGIN=https://your-frontend.example

# Existing account emails allowed to curate courses. Empty disables editing.
ADMIN_EMAILS=
# Optional, for automatic playlist import. Individual embeds need no key.
YOUTUBE_API_KEY=
